// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// prisma/schema.prisma

model User {
  id         String      @id @default(uuid())
  clerkId    String      @unique // เชื่อมกับ Clerk
  email      String      @unique
  name       String
  interviews Interview[]
  feedbacks  Feedback[]
  createdAt  DateTime    @default(now())
  role       Role        @default(USER)
}

model Interview {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [clerkId])
  position     String    // ตำแหน่งที่สมัคร
  level        String    // ระดับ (Junior/Senior)
  transcript   String?   @db.Text // เก็บข้อความสนทนาทั้งหมด
  audioUrl     String?   // เผื่อเก็บไฟล์เสียงย้อนหลัง
  score        Json?     // เก็บผลวิเคราะห์เป็น JSON (Logic, Comm, Tech)
  averageScore Float?    // เก็บค่าเฉลี่ยของคะแนน
  duration   Int?         //เวลาฝึก
  feedback     String?   @db.Text
  status       String    @default("completed")
  createdAt    DateTime  @default(now())
}

// ENUM ROLE สถานะ
enum Role {
  ADMIN
  USER
}

model JobPosition {
  id        String   @id @default(uuid())
  category  String
  title     String   @unique
  createdAt DateTime @default(now())
}

model Feedback {
  id                  String   @id @default(uuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [clerkId], onDelete: SetNull)
  position            String?
  level               String?
  hasCustomJd         Boolean  @default(false)
  experienceLevel     String?

  // ด้านที่ 1: UI / UX & Onboarding (1-5)
  ratingUiEase        Int?
  ratingUiInterview   Int?
  ratingUiDashboard   Int?
  ratingUiHistory     Int?

  // ด้านที่ 2: ระบบสัมภาษณ์ด้วยเสียง AI (Vapi) (1-5)
  ratingVoiceNatural  Int?
  ratingVoiceLatency  Int?
  ratingVoiceStt      Int?
  ratingVoiceRelevance Int?

  // ด้านที่ 3: การประเมินผลและคำแนะนำ (Gemini) (1-5)
  ratingEvalFairness  Int?
  ratingEvalInsight   Int?
  ratingEvalPractical Int?
  ratingEvalSpeed     Int?

  // ส่วนที่ 3: ภาพรวม
  confidenceLevel     String?
  npsScore            Int?

  // ส่วนที่ 4: ความคิดเห็นเพิ่มเติม
  mostLiked           String?  @db.Text
  problemsFound       String?  @db.Text
  futureSuggestions   String?  @db.Text

  createdAt           DateTime @default(now())
}